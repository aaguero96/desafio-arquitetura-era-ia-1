# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Só o provider-fake e o gateway recebem estas chaves; o serviço app não.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Chave mestra do gateway (administração: criar chaves, ver gastos).
LITELLM_MASTER_KEY=sk-gateway-master-0001

# Chave virtual do gateway usada pela aplicação. Criada automaticamente pelo gateway-init.
HELPDESK_GATEWAY_KEY=sk-helpdesk-app-0001

# Chaves de demonstração do roteiro de governança (README). Criadas pelo gateway-init.
# demo-budget: orçamento de US$ 0,0001, estoura na primeira chamada.
# demo-rpm: limite de 1 requisição por minuto.
DEMO_BUDGET_KEY=sk-demo-budget-0001
DEMO_RPM_KEY=sk-demo-rpm-0001
